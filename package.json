{
  "name": "llm-usage-monitor-workspace",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "vp run build:packages && vp run build:web && vp run build:server && vp run build:agent && vp run build:extension",
    "build:packages": "tsc --noEmit",
    "build:web": "vp run --filter '@llm-usage-monitor/web' build",
    "build:server": "vp run --filter '@llm-usage-monitor/server' build",
    "build:agent": "vp run --filter '@llm-usage-monitor/source-host-agent' build",
    "build:extension": "vp run --filter 'llm-usage-monitor' build",
    "check": "vp run format:check && vp run lint && vp run typecheck && vp run test && vp run build",
    "dev": "vp run --filter '@llm-usage-monitor/web' build && vp run --filter '@llm-usage-monitor/server' dev",
    "standalone": "vp run build:web && vp run build:server && vp run build:agent && node apps/server/dist/cli.mjs start --tailnet --open --refresh",
    "standalone:refresh": "node apps/server/dist/cli.mjs refresh",
    "package:extension": "vp run build && vp run --filter 'llm-usage-monitor' package",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint .",
    "test": "node --experimental-strip-types --test apps/*/test/*.test.ts packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  }
}
