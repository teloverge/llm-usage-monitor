{
  "name": "llm-usage-monitor-workspace",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:packages && bun run build:web && bun run build:server && bun run build:agent && bun run build:extension",
    "build:packages": "tsc --noEmit",
    "build:web": "bun run --filter '@llm-usage-monitor/web' build",
    "build:server": "bun run --filter '@llm-usage-monitor/server' build",
    "build:agent": "bun run --filter '@llm-usage-monitor/source-host-agent' build",
    "build:extension": "bun run --filter 'llm-usage-monitor' build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "bun run --filter '@llm-usage-monitor/web' build && bun run --filter '@llm-usage-monitor/server' dev",
    "package:extension": "bun run build && bun run --filter 'llm-usage-monitor' package",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test apps/*/test/*.test.ts packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "packageManager": "bun@1.3.14"
}
